# Xcode and SwiftPM leave these behind, per user and per machine.
#
# Here rather than in the root .gitignore because this directory is copied
# wholesale into mjhere/tester-channel-ios, which needs the same rules and
# cannot see ours. One file, both repositories — see .github/workflows/sync-ios-sdk.yml.
xcuserdata/
.swiftpm/
.build/

# Covered at the root here too; repeated because the copy travels alone.
.DS_Store
